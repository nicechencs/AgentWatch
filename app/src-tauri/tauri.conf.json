{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentWatch",
  "version": "0.1.0",
  "identifier": "dev.agentwatch.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm -C ../ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentWatch",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/icon.png", "icons/icon.ico"]
  }
}
